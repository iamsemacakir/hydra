# Settings for running `npm run dev` outside Docker. Next.js reads them from .env.local.
# Create that file with `npm run setup:local`: it copies these lines and generates AUTH_SECRET.
# .env.local is ignored by Git and by Docker builds. Never put real secrets in this example.

AUTH_URL=http://localhost:3000
AUTH_SECRET=replace_with_a_random_32_byte_secret
AUTH_KEYCLOAK_ID=devops-web
# The throwaway client secret of the local development realm (infra/keycloak/devops-realm.json).
AUTH_KEYCLOAK_SECRET=devops-local-only
AUTH_KEYCLOAK_ISSUER=http://keycloak.localhost:8080/realms/devops
API_INTERNAL_URL=http://localhost:5000
NEXT_PUBLIC_ENABLE_DEMO=true
